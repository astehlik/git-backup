{
    "name": "astehlik/github-backup",
    "description": "Backup script for GitHub repositories",
    "license": "GPL3+",
    "authors": [
        {
            "name": "Alexander Stehlik",
            "email": "alexander.stehlik@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/console": "^7.1",
        "symfony/process": "^7.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.44",
        "friendsofphp/php-cs-fixer": "^3.64",
        "de-swebhosting/php-codestyle": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "SWebhosting\\GithubBackup\\": "src/"
        }
    },
    "bin": [
        "ghb"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    }
}
